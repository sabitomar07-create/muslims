{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A streetwear apparel product in the catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "collection": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "images": { "type": "array" },
        "colors": { "type": "array" },
        "sizes": { "type": "array" },
        "variants": { "type": "array" },
        "sku": { "type": "string", "maxLength": 64 },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "price", "stock", "isPublished"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product star rating and text review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "comment": { "type": "string", "maxLength": 2000 },
        "verifiedPurchase": { "type": "boolean" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "comment", "status", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "userEmail", "items", "subtotal", "total", "status", "createdAt"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "User saved products wishlist",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "productIds"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Newsletter email subscription record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "subscribedAt": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "email", "subscribedAt", "active"]
    },
    "DiscountCode": {
      "title": "DiscountCode",
      "description": "Promotional coupon code for checkout discounts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 50 },
        "discountPercent": { "type": "number" },
        "minSpend": { "type": "number" },
        "isActive": { "type": "boolean" },
        "validUntil": { "type": "string" }
      },
      "required": ["id", "code", "discountPercent", "isActive"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global storefront configurations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "announcementText": { "type": "string", "maxLength": 300 },
        "currency": { "type": "string", "maxLength": 10 },
        "freeShippingThreshold": { "type": "number" },
        "contactEmail": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "announcementText", "currency"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrative user record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store apparel products"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product customer ratings and reviews"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/wishlists/{userId}": {
      "schema": "Wishlist",
      "description": "User saved favorite items"
    },
    "/newsletterSubscribers/{subscriberId}": {
      "schema": "NewsletterSubscriber",
      "description": "Email newsletter subscribers"
    },
    "/discountCodes/{codeId}": {
      "schema": "DiscountCode",
      "description": "Store discount coupons"
    },
    "/siteSettings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Store settings and announcement bar"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Store administrators with permission checks"
    }
  }
}
